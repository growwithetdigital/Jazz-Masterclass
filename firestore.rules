rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /audioTakes/{takeId} {
      allow read: if true;
      allow create: if isValidId(takeId) && 
                    request.resource.data.studentUid is string && 
                    request.resource.data.tuneTitle is string;
      allow update, delete: if isValidId(takeId) && 
                            (!isSignedIn() || resource.data.studentUid == request.auth.uid);
    }

    match /practiceLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && 
                    request.resource.data.studentUid is string;
      allow update, delete: if isValidId(logId) && 
                            (!isSignedIn() || resource.data.studentUid == request.auth.uid);
    }

    match /practiceSessions/{sessionId} {
      allow read: if true;
      allow create: if isValidId(sessionId) && 
                    request.resource.data.studentUid is string &&
                    request.resource.data.minutes is number;
      allow update, delete: if isValidId(sessionId) && 
                            (!isSignedIn() || resource.data.studentUid == request.auth.uid);
    }

    match /practiceGoals/{goalId} {
      allow read: if true;
      allow create, update: if isValidId(goalId) && 
                            request.resource.data.studentUid is string;
      allow delete: if isValidId(goalId) && 
                    (!isSignedIn() || resource.data.studentUid == request.auth.uid);
    }
  }
}
